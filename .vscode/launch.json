{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Circle",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/circle/bin/circle",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/circle",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build with Makefile"
    }
  ]
}